$(BUILD)/data/EFFECT/%.BIN: LDFLAGS += \
	--defsym=vs_scratch=0x1F800000

$(BUILD)/src/EFFECT/%.o: CC1VER := 2.8.1-psx
$(BUILD)/src/EFFECT/%.o: ASFLAGS += -no-pad-sections

PLGBINS = $(foreach n,$(1),$(BUILD)/data/EFFECT/PLG$(n).BIN)

BINARIES += $(patsubst %,EFFECT/%.BIN,EFFPURGE $(addprefix PLG,005 044 045 047 049 050 051 053 057 061 065 \
	069 073 077 081 082 085 086 087 114 128 129 134 135 137 138 139 141 142 143 146 147 148 149 150 152 153 \
	154 156 158 160 161 162 165 166 167 168 169 170 198 224 232 236 242 246 250 255 260))
DUPED_BINARIES := $(call PLGBINS,048 052 054 055 056 058 059 060 062 063 064 066 \
	067 068 070 071 072 074 075 076 078 079 080 083 084 102 131 133 136 140 144 145 151 155 157 159 164 199 221 \
	243 269 245 247 248 251 258 259 271 280 290)
EMPTY_BINARIES := $(call PLGBINS,001 002 003 004 006 007 008 009 010 011 012 013 \
	014 015 016 017 018 019 020 021 022 023 024 025 026 027 028 029 030 031 032 033 034 035 036 037 038 039 \
	040 041 042 043 046 088 089 090 091 092 093 094 095 096 097 098 099 100 101 103 104 105 106 107 109 110 \
	111 112 113 115 116 117 118 119 120 121 122 123 124 125 126 127 130 132 163 171 172 173 174 175 176 177 \
	178 179 180 181 182 183 184 185 186 187 188 189 190 191 192 193 194 195 196 197 200 201 202 203 204 205 \
	206 207 208 209 210 211 212 213 214 215 216 217 218 219 220 222 223 225 226 227 228 229 230 231 233 234 \
	235 237 238 239 244 249 252 253 254 256 257 261 262 264 267 268 270 274 275 276 277 278 279 281 282 283 \
	284 285 286 287 288 289 292 293 294 295 296 298 299 302 303 304 305 306 307 308 309 310)
TARGETS += $(DUPED_BINARIES) $(EMPTY_BINARIES)

