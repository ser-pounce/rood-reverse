$(BUILD)/data/EFFECT/%.BIN: LDFLAGS += \
	--defsym=vs_scratch=0x1F800000


$(BUILD)/src/EFFECT/%.o: CC1VER := 2.8.1-psx
$(BUILD)/src/EFFECT/%.o: ASFLAGS += -no-pad-sections

BINARIES += $(patsubst %,EFFECT/%.BIN,EFFPURGE $(addprefix PLG,005 044 045 047 049 050 051 053 057 061 065 069 073))
DUPED_BINARIES := $(patsubst %,$(BUILD)/data/EFFECT/PLG%.BIN,048 052 054 055 056 058 059 060 062 063 064 066 067 068 070 071 072 074 075 076 083 102 131 133 140 144 145 151 164 248 251 258 290)
EMPTY_BINARIES := $(patsubst %,$(BUILD)/data/EFFECT/PLG%.BIN,001 002 003 004 006 007 008 009 010 011 012 013 014 015 016 017 018 019 020 021 022 023 024 025 026 027 028 029 030 031 032 033 034 035 036 037 038 039 040 041 042 043 046)
TARGETS += $(DUPED_BINARIES) $(EMPTY_BINARIES)

$(patsubst %,$(BUILD)/data/EFFECT/PLG%.BIN,048 083 131 133 144 145): $(BUILD)/data/EFFECT/PLG044.BIN
$(patsubst %,$(BUILD)/data/EFFECT/PLG%.BIN,102 140 164 290): $(BUILD)/data/EFFECT/PLG045.BIN
$(patsubst %,$(BUILD)/data/EFFECT/PLG%.BIN,151 248 251 258): $(BUILD)/data/EFFECT/PLG047.BIN
$(BUILD)/data/EFFECT/PLG052.BIN: $(BUILD)/data/EFFECT/PLG051.BIN
$(patsubst %,$(BUILD)/data/EFFECT/PLG%.BIN,054 055 056): $(BUILD)/data/EFFECT/PLG053.BIN
$(patsubst %,$(BUILD)/data/EFFECT/PLG%.BIN,058 059 060): $(BUILD)/data/EFFECT/PLG057.BIN
$(patsubst %,$(BUILD)/data/EFFECT/PLG%.BIN,062 063 064): $(BUILD)/data/EFFECT/PLG061.BIN
$(patsubst %,$(BUILD)/data/EFFECT/PLG%.BIN,066 067 068): $(BUILD)/data/EFFECT/PLG065.BIN
$(patsubst %,$(BUILD)/data/EFFECT/PLG%.BIN,070 071 072): $(BUILD)/data/EFFECT/PLG069.BIN
$(patsubst %,$(BUILD)/data/EFFECT/PLG%.BIN,074 075 076): $(BUILD)/data/EFFECT/PLG073.BIN

$(DUPED_BINARIES):
	$(ECHO) "Copying duped binary $< -> $@"
	$(CP) $< $@

$(EMPTY_BINARIES):
	$(ECHO) "Creating empty file $@"
	$(TOUCH) $@
